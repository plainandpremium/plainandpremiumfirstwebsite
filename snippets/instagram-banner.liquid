<aside class="instagram-banner" aria-label="Instagram offer">
  <a class="instagram-banner__link" href="https://www.instagram.com/plainandpremium/" target="_blank" rel="noopener noreferrer" aria-label="Follow plainandpremium on Instagram and DM to get flat ₹100 off (opens in a new tab)">
  <div class="instagram-banner__track" aria-hidden="true">
    {% for group in (1..2) %}
      <div class="instagram-banner__group"{% if group == 2 %} aria-hidden="true"{% endif %}>
        {% for repeat in (1..3) %}
          <span class="instagram-banner__message">
            <svg class="instagram-banner__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
            <span>Follow us on Instagram and DM to get flat ₹100 off</span>
          </span>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
  </a>
  <button class="instagram-banner__pause" type="button" aria-label="Pause scrolling offer" aria-pressed="false" onclick="var paused = this.parentElement.classList.toggle('is-paused'); this.setAttribute('aria-pressed', String(paused)); this.setAttribute('aria-label', paused ? 'Resume scrolling offer' : 'Pause scrolling offer'); this.textContent = paused ? '▶' : 'Ⅱ';">Ⅱ</button>
</aside>
